<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same choice as backup_rules.xml, for both cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/reel_usage.preferences_pb" />
        <include domain="file" path="datastore/daily_usage.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/reel_usage.preferences_pb" />
        <include domain="file" path="datastore/daily_usage.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
